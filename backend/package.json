{
  "name": "backend",
  "author": {
    "name": "Ketbome",
    "email": "pablo.moraga.san@gmail.com"
  },
  "version": "1.12.0",
  "description": "",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/common": "12.5.1",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/mapped-types": "12.0.1",
    "@nestjs/passport": "12.0.2",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/typeorm": "12.0.3",
    "@types/archiver": "^8.0.0",
    "adm-zip": "^0.6.1",
    "archiver": "8.0.0",
    "axios": "1.21.1",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.10.6",
    "fs-extra": "11.4.1",
    "js-yaml": "5.5.0",
    "lodash": "^4.18.1",
    "nodemailer": "^10.6.0",
    "openid-client": "^6.9.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "prismarine-nbt": "^2.8.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sql.js": "1.16.0",
    "typeorm": "1.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.13",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.5.1",
    "@types/bcrypt": "6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "5.0.6",
    "@types/fs-extra": "11.0.4",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "source-map-support": "0.5.21",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "webpack": "5.112.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/*.module.ts",
      "!**/main.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "statements": 90,
        "functions": 90,
        "branches": 80
      }
    },
    "coverageReporters": [
      "text-summary",
      "json-summary",
      "lcov"
    ],
    "testTimeout": 30000
  },
  "files": [
    "dist"
  ]
}
